# =============================================================
# Heavy files / dirs that should NOT be in version control.
# All can be regenerated from scripts or re-downloaded from DAiSEE.
# =============================================================

# Raw DAiSEE videos (14 GB) — must be downloaded separately from
# https://iith.ac.in/~daisee-dataset/  (Labels/ CSVs are kept; see below.)
DAiSEE/DataSet/
DAiSEE/Sample_Output/

# Extracted JPEG frames (720 MB combined) — regenerated by
# scripts/01_sample_and_extract_frames.py, 07_extract_multiframes.py,
# 09_extract_full_frames.py, 12_extract_extra_timestamps.py,
# 180b_extract_8frames.py.
frames_full/Train/
frames_full/Validation/
frames_full/Test/
frames_full_multi/
sampled_frames/
sampled_frames_multiframe/
frames_8/

# Per-clip Python venv and IDE artefacts
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Cached experiment artefacts (~1.2 GB of saved model weights). These
# are best regenerated locally by re-running the relevant training
# script (scripts/152_*, scripts/170_*, scripts/190_*, etc.).
models/

# Large pretrained-encoder feature dumps (kept selectively below).
# DEFAULT: ignore everything in features/, then unblock the ones MEME
# and the diagnostic paper actually need.
features/*

# UNBLOCK essential features needed for MEME (script 211) and the
# diagnostic paper (recipe / IDEP / within-subject / DREAM):
# (No trailing inline comments — git treats them as part of the pattern.)
!features/daisee_siglip_l_features.npz
!features/daisee_siglip_l_multiframe_features.npz
!features/daisee_face_signals.npz
!features/daisee_face_signals_temporal.npz
!features/daisee_pose_signals.npz
!features/dream_anchors.npz
!features/face_bboxes.json
!features/.gitkeep

# Large cached probability arrays inside results/sota/. The JSON
# summaries are pushed; the .npz caches are not — they can be
# regenerated by re-running scripts/80_* / 86_* / 87_* etc.
results/sota/_*.npz
results/sota/*partial*
results/sota/fusion_probs.npz

# Large PDFs / ZIPs from the CVPR submission cycle that aren't needed
# for BMVC reproduction.
*.zip
~$*.docx
~$*.xlsx
archive.zip
author-kit/
vlm_engagement_paper*.pdf
vlm_engagement_paper*.zip
cvpr_workshop_final_paper.pdf
BMVC_*.docx

# Misc local artefacts
*.log
results/sota/*.log
*.tmp
*.bak

# Claude harness scratch artefacts
.claude/

# Unused legacy: DAiSEE auxiliary scripts/files not needed for BMVC.
DAiSEE/GenderClips
DAiSEE/extractFrames.py
DAiSEE/hog.py
DAiSEE/README.txt

# Legacy CVPR paper PDF figures (paper_bmvc/figures supersedes these).
paper/figures/
